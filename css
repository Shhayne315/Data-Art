body {
    font-family: sans-serif;
    background-color: #f8fafc;
    color: #0f172a;
    margin: 0;
    padding: 0;
}
header {
    background-color: #ffffff;
    padding: 15px 20px;
    border-bottom: 1px solid #e2e8f0;
}
header h1 {
    font-size: 24px;
    color: #4338ca;
    margin: 0;
}
main {
    padding: 20px;
}
#filters {
    text-align: center;
    margin-bottom: 20px;
    color: #64748b;
}
#timeline {
    position: relative;
    padding-left: 40px;
    border-left: 3px solid #e2e8f0;
}
.timeline-event {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 20px;
    position: relative;
}
.timeline-event::before {
    content: '';
    position: absolute;
    top: 20px;
    left: -49px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background-color: #4338ca;
    border: 3px solid #ffffff;
}
.event-card img {
    max-width: 100%;
    border-radius: 4px;
}
.event-card h2 {
    font-size: 20px;
    margin-top: 10px;
    margin-bottom: 5px;
}
.event-card p {
    color: #64748b;
    margin-bottom: 10px;
}
.event-card time {
    font-style: italic;
    font-size: 14px;
    color: #333;
}
#modal {
    display: none;
}
@media (max-width: 600px) {
    body {
        font-size: 14px;
    }
    header {
        text-align: center;
    }
    #timeline {
        padding-left: 30px;
    }
    .timeline-event::before {
        left: -39px;
    }
}
